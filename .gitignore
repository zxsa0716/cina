# API keys and secrets
.env
.env.*
*.pem
*.key
secrets/
*.token
*credentials*

# LLM provider keys (extra defense)
**/anthropic_*.txt
**/openai_*.txt
**/gemini_*.txt
**/groq_*.txt

# Data artifacts (raw and processed; public release via Zenodo separately)
data/raw/
data/processed/
data/llm_logs/
data/calibration/*.pkl
data/runs/
!data/.gitkeep
!data/README.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb.bak

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
